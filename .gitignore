# Estado local del CLI de Supabase (a qué proyecto está enlazada esta copia).
# Es por máquina, no del proyecto.
supabase/.temp/

# Secretos locales: nunca se versionan. El archivo .env.example sí se conserva.
supabase/.env
supabase/.env.local

# Artefactos locales de validación y empaquetado.
output/

# Dependencias locales de pruebas (por ejemplo @electric-sql/pglite para tests/radiograph-pglite-stage1.test.mjs).
node_modules/
