+    { sb, fetchFn: fetch, graphVersion: GRAPH_API_VERSION, token: WHATSAPP_TOKEN, log: console.error },
+    { tenantId, actorRole: actor.role, body },
+  );
+  return json(resultado.body, resultado.status);
+}
