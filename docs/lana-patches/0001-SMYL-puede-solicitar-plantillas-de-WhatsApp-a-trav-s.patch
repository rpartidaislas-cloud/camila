+function mundo(opciones = {}) {
+  const db = {
+    llamadas: [], fallos: {}, ahora: () => Date.now(),
+    tablas: { tenants: [{ id: TENANT, config_json: { whatsapp: { connected: true, waba_id: '999' } } }], wa_plantillas: [] },
+    from(tabla) { return new Consulta(db, tabla); },
+  };
+  const meta = { llamadas: [], respuesta: null, lista: [], lanzar: false };
+  const fetchFn = async (url, init = {}) => {
+    const llamada = { url: String(url), metodo: (init.method || 'GET'), cuerpo: init.body ? JSON.parse(init.body) : null, autorizacion: (init.headers || {}).Authorization };
+    meta.llamadas.push(llamada);
+    if (meta.lanzar && llamada.metodo === 'POST') throw new Error('red caída');
+    if (llamada.metodo === 'GET') return new Response(JSON.stringify({ data: meta.lista }), { status: 200 });
+    const r = meta.respuesta || { status: 200, cuerpo: { id: 'meta-1', status: 'PENDING', category: 'UTILITY' } };
+    return new Response(JSON.stringify(r.cuerpo), { status: r.status });
+  };
+  const registros = [];
+  const deps = { sb: db, fetchFn, graphVersion: 'v20.0', token: opciones.sinToken ? '' : 'TOKEN-SECRETO-DE-META', log: (...a) => registros.push(a.join(' ')), ahora: () => db.ahora() };
+  return { db, meta, deps, registros, filas: () => db.tablas.wa_plantillas };
+}
