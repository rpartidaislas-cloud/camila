+// task-id smyl-solicitar-plantillas-whatsapp. SMYL solicita plantillas a Meta a través de camila-api
+// (POST /inbox/whatsapp/templates) y consulta su estado (GET ...?status=all). Las reglas puras se
+// prueban de verdad; el handler (Deno) se verifica estructuralmente, igual que el resto de
+// tests sobre supabase/functions/.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {
+  CATEGORIAS_PLANTILLA_SMYL,
+  clasificarErrorMeta,
+  motivoRechazoVisible,
+  normalizarCategoriaPlantilla,
+  normalizarEstadoPlantilla,
+  LIMITE_CREACION_PLANTILLAS_POR_HORA,
+  construirComponentesMeta,
+  esConflictoNombreMeta,
+  mensajeErrorMeta,
+  tituloVisibleDesdeNombre,
+  plantillaWhatsappDto,
+  procesarSolicitudPlantillaSmyl,
+  validarSolicitudPlantillaSmyl,
+} from '../supabase/functions/camila-api/wa-plantilla-smyl.mjs';
+
+const source = fs.readFileSync(new URL('../supabase/functions/camila-api/index.ts', import.meta.url), 'utf8');
+
+const valida = () => ({
+  name: 'recordatorio_cita_24h_v1', category: 'UTILITY', language: 'es_MX',
+  body: 'Hola {{1}}, te recordamos tu cita el {{2}} a las {{3}} en {{4}}. Responde a este mensaje si necesitas cambiarla.',
+  examples: ['Ana', 'martes 21 de octubre', '10:30 a.m.', 'Clínica Dental Sonríe'],
+});
+
+test('una solicitud correcta se acepta y se normaliza', () => {
+  const resultado = validarSolicitudPlantillaSmyl({ ...valida(), category: 'utility', language: '' });
+  assert.equal(resultado.ok, true);
+  assert.equal(resultado.valor.categoria, 'UTILITY');
+  assert.equal(resultado.valor.idioma, 'es_MX');
+  assert.equal(resultado.valor.cantidadVariables, 4);
+  assert.deepEqual(resultado.valor.botones, []);
+  assert.equal(resultado.valor.pie, '');
+});
+
+test('rechaza lo que Meta rechazaría, con un mensaje claro y sin llegar a Meta', () => {
+  const casos = [
+    ['cuerpo no objeto', null, /no es válido/],
+    ['nombre con mayúsculas', { name: 'Cita_Hoy' }, /minúsculas/],
+    ['categoría de autenticación', { category: 'AUTHENTICATION' }, /UTILITY o MARKETING/],
+    ['idioma desconocido', { language: 'fr_FR' }, /Idioma/],
+    ['cuerpo vacío', { body: '   ' }, /entre 1 y 1024/],
+    ['cuerpo demasiado largo', { body: 'a'.repeat(1025) }, /entre 1 y 1024/],
+    ['variables con salto', { body: 'Hola {{1}}, tu cita es el {{3}} en nuestra clínica dental de siempre.', examples: ['a', 'b'] }, /en orden/],
+    ['variable al inicio', { body: '{{1}} te recordamos tu cita de mañana en nuestra clínica dental.', examples: ['Ana'] }, /primero o lo último/],
+    ['variable al final', { body: 'Te recordamos con mucho gusto tu cita de mañana, que será con {{1}}', examples: ['Ana'] }, /primero o lo último/],
+    ['variables pegadas', { body: 'Hola Ana, tu cita es el {{1}} {{2}} en nuestra clínica dental de siempre, te esperamos.', examples: ['a', 'b'] }, /dos variables/i],
+    ['demasiadas variables para el texto', { body: 'Hola {{1}}, cita {{2}} hora {{3}} lugar {{4}}.', examples: ['a', 'b', 'c', 'd'] }, /demasiadas variables/],
+    ['faltan ejemplos', { examples: ['Ana'] }, /un ejemplo por cada variable/],
+    ['ejemplo con salto de línea', { examples: ['Ana\nLópez', 'b', 'c', 'd'] }, /ejemplo/],
+    ['pie con variable', { footer: 'Clínica {{1}}' }, /pie de página/],
+    ['pie demasiado largo', { footer: 'x'.repeat(61) }, /pie de página/],
+    ['más de tres botones', { buttons: ['a', 'b', 'c', 'd'].map((text) => ({ type: 'QUICK_REPLY', text })) }, /tres botones/],
+    ['botón con liga', { buttons: [{ type: 'URL', text: 'Ver', url: 'https://x.test' }] }, /respuesta rápida/],
+    ['botón demasiado largo', { buttons: [{ type: 'QUICK_REPLY', text: 'x'.repeat(26) }] }, /25 caracteres/],
+  ];
+  for (const [nombre, cambio, esperado] of casos) {
+    const entrada = cambio === null ? null : { ...valida(), ...cambio };
+    const resultado = validarSolicitudPlantillaSmyl(entrada);
