+
+class Consulta {
+  constructor(db, tabla) { this.db = db; this.tabla = tabla; this.filtros = []; this.modo = 'select'; }
+  select(_columnas, opciones) { if (opciones && opciones.head) this.soloConteo = true; if (this.modo !== 'select') this.devolver = true; return this; }
+  insert(fila) { this.modo = 'insert'; this.fila = fila; return this; }
+  update(parche) { this.modo = 'update'; this.parche = parche; return this; }
+  delete() { this.modo = 'delete'; return this; }
+  eq(c, v) { this.filtros.push((r) => r[c] === v); return this; }
+  in(c, vs) { this.filtros.push((r) => vs.includes(r[c])); return this; }
+  gte(c, v) { this.filtros.push((r) => String(r[c]) >= String(v)); return this; }
+  is(c, v) { this.filtros.push((r) => (v === null ? r[c] == null : r[c] === v)); return this; }
+  maybeSingle() { this.unico = true; return this; }
+  then(resolver) {
+    this.db.llamadas.push(this.modo + ':' + this.tabla);
+    const filas = this.db.tablas[this.tabla] || (this.db.tablas[this.tabla] = []);
+    const fallo = this.db.fallos && this.db.fallos[this.modo + ':' + this.tabla];
+    if (fallo) return resolver({ data: null, error: fallo });
+    if (this.modo === 'insert') {
+      if (filas.some((r) => r.tenant_id === this.fila.tenant_id && r.nombre === this.fila.nombre && r.idioma === this.fila.idioma)) return resolver({ data: null, error: { code: '23505' } });
+      filas.push({ id: crypto.randomUUID(), meta_template_id: null, motivo_rechazo: null, created_at: new Date(this.db.ahora()).toISOString(), updated_at: new Date().toISOString(), ...this.fila });
+      return resolver({ data: null, error: null });
+    }
+    const coincidentes = filas.filter((r) => this.filtros.every((f) => f(r)));
+    if (this.modo === 'update') { coincidentes.forEach((r) => Object.assign(r, this.parche)); return resolver({ data: this.unico ? (coincidentes[0] ? { ...coincidentes[0] } : null) : coincidentes.map((r) => ({ ...r })), error: null }); }
+    if (this.modo === 'delete') { this.db.tablas[this.tabla] = filas.filter((r) => !coincidentes.includes(r)); return resolver({ data: null, error: null }); }
+    if (this.soloConteo) return resolver({ count: coincidentes.length, data: null, error: null });
+    return resolver({ data: this.unico ? (coincidentes[0] ? { ...coincidentes[0] } : null) : coincidentes.map((r) => ({ ...r })), error: null });
+  }
+}
