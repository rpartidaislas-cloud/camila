+// POST /inbox/whatsapp/templates — SMYL solicita una plantilla a Meta por nosotros.
+// Solo el propietario de SMYL: crear una plantilla real gasta cupo de revisión y los rechazos
+// repetidos pueden afectar la reputación de la cuenta (mismo criterio que wa-plantilla-crear).
+// El estado final (APPROVED/REJECTED) lo actualiza whatsapp-webhook con message_template_status_update.
+// La lógica vive en wa-plantilla-smyl.mjs (procesarSolicitudPlantillaSmyl) para poder probarla de verdad.
+async function crearPlantillaWhatsappInbox(tenantId: string, actor: SmylInboxActor, req: Request): Promise<Response> {
+  if (actor.role !== "owner") return json({ error: "Solo el propietario de la clínica puede solicitar plantillas.", code: "owner_required" }, 403);
+  if (!validUuid(req.headers.get("Idempotency-Key"))) return json({ error: "Idempotency-Key debe ser un UUID válido." }, 400);
