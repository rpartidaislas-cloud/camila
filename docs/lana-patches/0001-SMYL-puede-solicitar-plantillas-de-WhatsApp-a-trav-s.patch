+  assert.deepEqual([...CATEGORIAS_PLANTILLA_SMYL], ['UTILITY', 'MARKETING']);
+});
+
+test('los componentes para Meta van en el orden BODY, FOOTER, BUTTONS y con ejemplos', () => {
+  const resultado = validarSolicitudPlantillaSmyl({
+    ...valida(), category: 'MARKETING', footer: 'Responde BAJA para no recibir más mensajes',
+    buttons: [{ type: 'QUICK_REPLY', text: 'Sí, quiero agendar' }, { type: 'QUICK_REPLY', text: 'Ahora no' }],
+  });
+  const componentes = construirComponentesMeta(resultado.valor);
+  assert.deepEqual(componentes.map((componente) => componente.type), ['BODY', 'FOOTER', 'BUTTONS']);
+  assert.deepEqual(componentes[0].example, { body_text: [['Ana', 'martes 21 de octubre', '10:30 a.m.', 'Clínica Dental Sonríe']] });
+  assert.equal(componentes[1].text, 'Responde BAJA para no recibir más mensajes');
+  assert.deepEqual(componentes[2].buttons, [{ type: 'QUICK_REPLY', text: 'Sí, quiero agendar' }, { type: 'QUICK_REPLY', text: 'Ahora no' }]);
+  const sinVariables = validarSolicitudPlantillaSmyl({ name: 'aviso_simple', category: 'UTILITY', body: 'Tu cita quedó confirmada. Gracias por elegirnos.', examples: [] });
+  assert.equal(construirComponentesMeta(sinVariables.valor)[0].example, undefined, 'sin variables no se manda example');
+});
+
+test('reconoce el conflicto de nombre de Meta y extrae su mensaje sin filtrar nada más', () => {
+  assert.equal(esConflictoNombreMeta('Ya hay contenido en español para esta plantilla'), true);
+  assert.equal(esConflictoNombreMeta('Template name already exists'), true);
+  assert.equal(esConflictoNombreMeta('Invalid parameter'), false);
+  assert.equal(mensajeErrorMeta({ error: { error_user_msg: 'Mensaje para el usuario', message: 'técnico', access_token: 'secreto' } }), 'Mensaje para el usuario');
+  assert.equal(mensajeErrorMeta({}), '');
+  assert.equal(tituloVisibleDesdeNombre('recordatorio_cita_24h_v1'), 'Recordatorio Cita 24h V1');
+  assert.ok(LIMITE_CREACION_PLANTILLAS_POR_HORA > 0 && LIMITE_CREACION_PLANTILLAS_POR_HORA <= 20);
+});
+
+test('normaliza {{ 1 }} a {{1}} antes de validar y de enviar a Meta', () => {
+  const resultado = validarSolicitudPlantillaSmyl({ ...valida(), body: 'Hola {{ 1 }}, te recordamos tu cita el {{2 }} a las {{ 3}} en {{4}}. Responde a este mensaje si necesitas cambiarla.' });
+  assert.equal(resultado.ok, true);
+  assert.match(resultado.valor.cuerpo, /^Hola \{\{1\}\}, .*\{\{2\}\} a las \{\{3\}\} en \{\{4\}\}\./);
+});
+
+test('clasifica los errores de Meta: conflicto, caída/credenciales y rechazo de contenido', () => {
+  assert.equal(clasificarErrorMeta(400, { error: { message: 'Template name already exists', code: 100 } }), 'conflicto');
+  assert.equal(clasificarErrorMeta(400, { error: { code: 190, message: 'Error validating access token' } }), 'no_disponible');
+  assert.equal(clasificarErrorMeta(400, { error: { code: 80008, message: 'Too many calls' } }), 'no_disponible');
+  assert.equal(clasificarErrorMeta(503, {}), 'no_disponible');
+  assert.equal(clasificarErrorMeta(400, { error: { code: 100, error_user_msg: 'Formato de variables inválido' } }), 'rechazada');
+});
+
+test('guarda el estado y la categoría que Meta devuelve, con valores seguros por omisión', () => {
+  assert.equal(normalizarEstadoPlantilla('approved'), 'APPROVED');
+  assert.equal(normalizarEstadoPlantilla('algo_raro'), 'PENDING');
+  assert.equal(normalizarEstadoPlantilla(undefined), 'PENDING');
+  assert.equal(normalizarCategoriaPlantilla('MARKETING', 'UTILITY'), 'MARKETING', 'Meta reclasificó la plantilla');
+  assert.equal(normalizarCategoriaPlantilla('utility', 'UTILITY'), 'UTILITY');
+  assert.equal(normalizarCategoriaPlantilla('', 'UTILITY'), 'UTILITY');
+  assert.equal(normalizarCategoriaPlantilla('OTRA', 'MARKETING'), 'MARKETING');
+});
+
+test('el motivo de rechazo solo se muestra en plantillas rechazadas y nunca como "NONE"', () => {
+  assert.equal(motivoRechazoVisible('REJECTED', 'INVALID_FORMAT'), 'INVALID_FORMAT');
+  assert.equal(motivoRechazoVisible('APPROVED', 'NONE'), null);
+  assert.equal(motivoRechazoVisible('APPROVED', 'INVALID_FORMAT'), null);
+  assert.equal(motivoRechazoVisible('REJECTED', 'none'), null);
+  assert.equal(motivoRechazoVisible('REJECTED', ''), null);
+});
+
+test('GET /inbox/whatsapp/templates conserva su comportamiento y ?status=all agrega estado y motivo de rechazo', () => {
+  const list = source.slice(source.indexOf('async function listarPlantillasWhatsappInbox'), source.indexOf('async function crearPlantillaWhatsappInbox'));
+  assert.match(list, /url\.searchParams\.get\("status"\) === "all"/);
+  assert.match(list, /motivo_rechazo/);
+  assert.match(list, /\.eq\("categoria", "UTILITY"\)\s*\.eq\("estado", "APPROVED"\)\s*\.eq\("activo", true\)/);
+  assert.match(source, /listarPlantillasWhatsappInbox\(tenantId, url\)/);
+  const dto = plantillaWhatsappDto({ id: 'x', nombre: 'n', idioma: 'es_MX', categoria: 'UTILITY', estado: 'APPROVED', motivo_rechazo: 'NONE', meta_template_id: 'secreto-meta', cuerpo: 'c', num_variables: 0 });
