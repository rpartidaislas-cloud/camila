diff --git a/supabase/functions/camila-api/wa-plantilla-smyl.mjs b/supabase/functions/camila-api/wa-plantilla-smyl.mjs
new file mode 100644
index 0000000..52e5468
--- /dev/null
+++ b/supabase/functions/camila-api/wa-plantilla-smyl.mjs
@@ -0,0 +1,296 @@
+// Reglas puras (sin Deno ni red) para que SMYL solicite plantillas de WhatsApp a través de
+// camila-api: POST /inbox/whatsapp/templates. Se mantiene en un .mjs aparte para poder
+// probarlas con `node --test` (este repo no tiene runtime de Deno en las pruebas).
+//
+// Solo valida lo que Meta exige técnicamente. Las políticas de contenido de SMYL (qué plantillas
+// se ofrecen a una clínica dental, opt-out en Marketing, etc.) las decide SMYL: nunca se manda
+// texto libre del navegador, solo plantillas de su catálogo revisado.
+
+export const CATEGORIAS_PLANTILLA_SMYL = Object.freeze(["UTILITY", "MARKETING"]);
+export const IDIOMAS_PLANTILLA_SMYL = Object.freeze(["es_MX", "es", "es_ES", "es_AR"]);
+// Crear plantillas gasta cupo de revisión y los rechazos repetidos cuentan para la reputación de la cuenta.
+export const LIMITE_CREACION_PLANTILLAS_POR_HORA = 10;
+
+const VARIABLE = /\{\{\s*(\d+)\s*\}\}/g;
+
+function numerosDeVariables(texto) {
+  const numeros = [];
+  String(texto || "").replace(VARIABLE, (_, numero) => { numeros.push(Number(numero)); return _; });
+  return Array.from(new Set(numeros)).sort((a, b) => a - b);
+}
+
+function rechazo(error) { return { ok: false, error }; }
+
+export function validarSolicitudPlantillaSmyl(body) {
+  if (!body || typeof body !== "object" || Array.isArray(body)) return rechazo("El cuerpo de la solicitud no es válido.");
+  const nombre = typeof body.name === "string" ? body.name.trim() : "";
+  const categoria = typeof body.category === "string" ? body.category.trim().toUpperCase() : "";
+  const idioma = body.language == null || body.language === "" ? "es_MX" : String(body.language).trim();
+  // Meta espera {{1}} sin espacios; {{ 1 }} se normaliza antes de validar y de enviar.
+  const cuerpo = typeof body.body === "string" ? body.body.trim().replace(/\{\{\s*(\d+)\s*\}\}/g, "{{$1}}") : "";
+  const pie = body.footer == null ? "" : typeof body.footer === "string" ? body.footer.trim() : null;
+  const botonesEntrada = body.buttons == null ? [] : body.buttons;
+  const ejemplos = body.examples == null ? [] : body.examples;
+
+  if (!/^[a-z0-9_]{1,200}$/.test(nombre)) return rechazo("El nombre solo puede tener minúsculas, números y guion bajo (_).");
+  if (!CATEGORIAS_PLANTILLA_SMYL.includes(categoria)) return rechazo("Categoría no permitida: solo UTILITY o MARKETING.");
+  if (!IDIOMAS_PLANTILLA_SMYL.includes(idioma)) return rechazo("Idioma no permitido.");
+  if (!cuerpo || cuerpo.length > 1024) return rechazo("El mensaje debe tener entre 1 y 1024 caracteres.");
+
+  const numeros = numerosDeVariables(cuerpo);
+  if (!numeros.every((numero, indice) => numero === indice + 1)) return rechazo("Las variables deben ir en orden y sin saltos: {{1}}, {{2}}, {{3}}…");
+  if (/^\{\{\s*\d+\s*\}\}/.test(cuerpo) || /\{\{\s*\d+\s*\}\}$/.test(cuerpo)) return rechazo("Meta no permite que una variable sea lo primero o lo último del mensaje.");
+  if (/\}\}\s{0,3}\{\{/.test(cuerpo)) return rechazo("Meta no permite dos variables seguidas.");
+  const palabras = cuerpo.replace(VARIABLE, " ").split(/\s+/).filter(Boolean).length;
+  if (palabras < numeros.length * 4) return rechazo("Hay demasiadas variables para la longitud del mensaje.");
+
+  if (!Array.isArray(ejemplos) || ejemplos.length !== numeros.length) return rechazo("Se necesita un ejemplo por cada variable.");
+  for (const ejemplo of ejemplos) {
+    if (typeof ejemplo !== "string" || !ejemplo.trim() || ejemplo.length > 200 || /[\n\t]| {4,}/.test(ejemplo)) return rechazo("Un ejemplo de variable no es válido.");
+  }
+
+  if (pie === null || pie.length > 60 || /\{\{/.test(pie)) return rechazo("El pie de página debe tener máximo 60 caracteres y sin variables.");
+
+  if (!Array.isArray(botonesEntrada) || botonesEntrada.length > 3) return rechazo("Se permiten máximo tres botones de respuesta rápida.");
+  const botones = [];
+  for (const boton of botonesEntrada) {
+    const texto = boton && typeof boton.text === "string" ? boton.text.trim() : "";
+    if (!boton || boton.type !== "QUICK_REPLY" || !texto || texto.length > 25) return rechazo("Cada botón debe ser de respuesta rápida y tener máximo 25 caracteres.");
+    botones.push({ type: "QUICK_REPLY", text: texto });
+  }
+
+  return {
+    ok: true,
+    valor: { nombre, categoria, idioma, cuerpo, pie, botones, ejemplos: ejemplos.map((ejemplo) => ejemplo.trim()), cantidadVariables: numeros.length },
+  };
+}
+
+// Orden que exige la API de Meta: BODY, FOOTER, BUTTONS.
+export function construirComponentesMeta(valor) {
+  const body = { type: "BODY", text: valor.cuerpo };
+  if (valor.cantidadVariables > 0) body.example = { body_text: [valor.ejemplos] };
+  const componentes = [body];
+  if (valor.pie) componentes.push({ type: "FOOTER", text: valor.pie });
+  if (valor.botones.length) componentes.push({ type: "BUTTONS", buttons: valor.botones.map((boton) => ({ type: "QUICK_REPLY", text: boton.text })) });
+  return componentes;
+}
+
+// Meta solo admite una versión por nombre + idioma; SMYL necesita nombres estables para reconocer
+// sus plantillas, así que un conflicto se informa en lugar de inventar un nombre nuevo.
+export function esConflictoNombreMeta(mensaje) {
+  const texto = String(mensaje || "").toLowerCase();
+  return texto.includes("already content") || texto.includes("ya hay contenido") || texto.includes("already exists")
+    || (texto.includes("language") && texto.includes("exist"));
+}
+
+export function mensajeErrorMeta(datos) {
+  const error = datos && datos.error ? datos.error : {};
+  return String(error.error_user_msg || error.message || "").slice(0, 400);
+}
+
+export function tituloVisibleDesdeNombre(nombre) {
+  return String(nombre || "").replace(/_/g, " ").replace(/\b\w/g, (letra) => letra.toUpperCase()).slice(0, 120);
+}
+
+// Estados que admite la restricción CHECK de wa_plantillas.
+const ESTADOS_PLANTILLA = ["PENDING", "APPROVED", "REJECTED", "PAUSED", "DISABLED", "PENDING_DELETION"];
+
+export function normalizarEstadoPlantilla(estado) {
+  const valor = String(estado || "").toUpperCase();
+  return ESTADOS_PLANTILLA.includes(valor) ? valor : "PENDING";
+}
+
+// Meta puede reclasificar una plantilla (p. ej. de UTILITY a MARKETING): se guarda lo que Meta devuelve.
+export function normalizarCategoriaPlantilla(categoriaMeta, solicitada) {
+  const valor = String(categoriaMeta || "").toUpperCase();
+  return ["UTILITY", "MARKETING", "AUTHENTICATION"].includes(valor) ? valor : solicitada;
+}
+
+// Códigos de Meta que no dependen del contenido: token vencido (190), límites de tasa (4, 17, 613, 80008, 130429)
+// o caídas del servicio. SMYL no debe presentarlos como "tu texto fue rechazado".
+const CODIGOS_META_NO_DE_CONTENIDO = [190, 4, 17, 613, 80008, 130429, 368, 2, 1];
+
+export function clasificarErrorMeta(estadoHttp, datos) {
+  const error = datos && datos.error ? datos.error : {};
+  if (esConflictoNombreMeta(mensajeErrorMeta(datos))) return "conflicto";
+  if (Number(estadoHttp) >= 500 || CODIGOS_META_NO_DE_CONTENIDO.includes(Number(error.code))) return "no_disponible";
+  return "rechazada";
+}
+
+// El motivo de rechazo de Meta llega como código (INVALID_FORMAT, ABUSIVE_CONTENT…); "NONE" significa que no hay.
+export function motivoRechazoVisible(estado, motivo) {
+  const texto = String(motivo || "").trim();
+  return String(estado || "").toUpperCase() === "REJECTED" && texto && texto.toUpperCase() !== "NONE" ? texto.slice(0, 500) : null;
+}
+
+// ── Solicitud completa (sin Deno: las dependencias se inyectan para poder probarla de verdad) ──
+
+const PLANTILLA_SELECT = "id,nombre,idioma,categoria,estado,motivo_rechazo,cuerpo,num_variables,variables_meta,meta_template_id,created_at,updated_at";
+const MARCADOR_PLANTILLA_VIGENTE_MS = 2 * 60 * 1000;
+
+function texto(valor, max) { return typeof valor === "string" ? valor.trim().slice(0, max) : ""; }
+
+export function plantillaWhatsappDto(item) {
+  return {
+    id: String(item.id || ""), name: texto(item.nombre, 180), language: texto(item.idioma, 40) || "es_MX",
+    category: texto(item.categoria, 20), status: texto(item.estado, 30),
+    rejection_reason: motivoRechazoVisible(item.estado, item.motivo_rechazo),
+    body: texto(item.cuerpo, 4000), variable_count: Math.max(0, Number(item.num_variables) || 0),
+    variable_types: Array.isArray(item.variables_meta) ? item.variables_meta : [],
+    created_at: item.created_at || null, updated_at: item.updated_at || null,
+  };
+}
+
+async function consultarPlantillaEnMeta({ fetchFn, graphVersion, token }, wabaId, nombre, idioma) {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 15000);
+  try {
+    const respuesta = await fetchFn(
+      `https://graph.facebook.com/${graphVersion}/${wabaId}/message_templates?name=${encodeURIComponent(nombre)}&language=${encodeURIComponent(idioma)}&limit=100&fields=id,name,language,status,category,components,rejected_reason`,
+      { headers: { "Authorization": `Bearer ${token}` }, signal: controller.signal },
+    );
+    const datos = await respuesta.json().catch(() => ({}));
+    const lista = Array.isArray(datos && datos.data) ? datos.data : [];
+    return lista.find((item) => item.name === nombre && item.language === idioma) || null;
+  } catch { return null; } finally { clearTimeout(timer); }
+}
+
+// Devuelve { status, body } para que el handler solo lo convierta en Response.
+//
+// Orden pensado para no dejar plantillas huérfanas ni saltarse el límite con solicitudes simultáneas:
+//  1. Se guarda primero un marcador (PENDING, sin meta_template_id): la restricción
+//     unique(tenant, nombre, idioma) serializa solicitudes iguales y sirve de idempotencia.
+//  2. Se cuenta el cupo DESPUÉS de insertar el marcador, así que dos solicitudes a la vez nunca
+//     se pasan del límite (a lo sumo se bloquean de más).
+//  3. Se llama a Meta; si falla se borra el marcador. Si Meta ya la tenía (respuesta perdida en un
+//     intento anterior) se adopta consultando a Meta, siempre que el texto coincida.
+export async function procesarSolicitudPlantillaSmyl(deps, entrada) {
+  const { sb, fetchFn, graphVersion, token, log, ahora } = deps;
+  const { tenantId, actorRole, body } = entrada;
+  const resp = (status, cuerpo) => ({ status, body: cuerpo });
+  const reloj = typeof ahora === "function" ? ahora : () => Date.now();
+
+  if (actorRole !== "owner") return resp(403, { error: "Solo el propietario de la clínica puede solicitar plantillas.", code: "owner_required" });
+  const solicitud = validarSolicitudPlantillaSmyl(body);
+  if (!solicitud.ok) return resp(400, { error: solicitud.error, code: "invalid_template" });
+  const valor = solicitud.valor;
+
+  const { data: existente, error: errorExistente } = await sb.from("wa_plantillas")
+    .select(PLANTILLA_SELECT)
+    .eq("tenant_id", tenantId).eq("nombre", valor.nombre).eq("idioma", valor.idioma).maybeSingle();
+  if (errorExistente) return resp(500, { error: "No se pudo consultar la plantilla.", code: "template_lookup_failed" });
+  // Un marcador es una fila que esta función creó y todavía no tiene id de Meta. Las filas con otro
+  // estado y sin id (plantillas registradas a mano) nunca se tocan ni se borran.
+  const esMarcador = Boolean(existente) && existente.estado === "PENDING" && !existente.meta_template_id;
+  if (existente) {
+    // Solo importa el texto: Meta pudo reclasificar la categoría y el reintento debe seguir siendo idempotente.
+    if (String(existente.cuerpo || "") !== valor.cuerpo) {
+      return resp(409, { error: "Ya existe una plantilla con ese nombre y otro contenido.", code: "template_name_taken" });
+    }
+    // Reintento seguro: si ya está registrada se devuelve tal cual, sin volver a llamar a Meta.
+    if (existente.meta_template_id || !esMarcador) return resp(200, { ok: true, existing: true, template: plantillaWhatsappDto(existente) });
+    // Marcador sin id de Meta: otra solicitud en curso, o una que se interrumpió hace rato.
+    if (reloj() - new Date(existente.created_at || 0).getTime() < MARCADOR_PLANTILLA_VIGENTE_MS) {
+      return resp(409, { error: "Esta plantilla ya se está enviando a Meta. Espera un momento.", code: "template_in_progress" });
+    }
+  }
+
+  const { data: tenantRow } = await sb.from("tenants").select("config_json").eq("id", tenantId).maybeSingle();
+  const wa = ((tenantRow && tenantRow.config_json) || {}).whatsapp;
+  if (!wa || wa.connected !== true || !wa.waba_id) return resp(409, { error: "WhatsApp todavía no está conectado en LANA.", code: "whatsapp_not_connected" });
+  if (!token) return resp(503, { error: "LANA no puede contactar a Meta en este momento.", code: "meta_unavailable" });
+
+  const eliminarMarcador = async () => {
+    const { error } = await sb.from("wa_plantillas").delete()
+      .eq("tenant_id", tenantId).eq("nombre", valor.nombre).eq("idioma", valor.idioma)
+      .eq("estado", "PENDING").is("meta_template_id", null);
+    if (error) log("crearPlantillaWhatsappInbox borrar marcador:", error.code);
+  };
+
+  if (esMarcador) {
+    // Marcador viejo que se reintenta: se renueva para que cuente dentro de la ventana del cupo.
+    await sb.from("wa_plantillas").update({ created_at: new Date(reloj()).toISOString() })
+      .eq("tenant_id", tenantId).eq("nombre", valor.nombre).eq("idioma", valor.idioma)
+      .eq("estado", "PENDING").is("meta_template_id", null);
+  } else if (!existente) {
+    const { error: errorMarcador } = await sb.from("wa_plantillas").insert({
+      tenant_id: tenantId, nombre: valor.nombre, titulo_visible: tituloVisibleDesdeNombre(valor.nombre), idioma: valor.idioma,
+      categoria: valor.categoria, cuerpo: valor.cuerpo, num_variables: valor.cantidadVariables, header_tipo: "NONE",
+      estado: "PENDING", variables_meta: new Array(valor.cantidadVariables).fill("texto_libre"),
+    });
+    if (errorMarcador) {
+      if (errorMarcador.code === "23505") return resp(409, { error: "Esta plantilla ya se está enviando a Meta. Espera un momento.", code: "template_in_progress" });
+      log("crearPlantillaWhatsappInbox marcador:", errorMarcador.code);
+      return resp(500, { error: "No se pudo preparar la plantilla.", code: "template_not_recorded" });
+    }
+  }
+
+  // Cupo: plantillas pendientes o rechazadas de la última hora (las que gastan revisión de Meta), contando ésta.
+  const { count: recientes, error: errorCupo } = await sb.from("wa_plantillas")
+    .select("id", { count: "exact", head: true })
+    .eq("tenant_id", tenantId)
+    .in("estado", ["PENDING", "REJECTED"])
+    .gte("created_at", new Date(reloj() - 60 * 60 * 1000).toISOString());
+  if (errorCupo || typeof recientes !== "number") {
+    await eliminarMarcador();
+    return resp(500, { error: "No se pudo revisar el límite de solicitudes.", code: "template_lookup_failed" });
+  }
+  if (recientes > LIMITE_CREACION_PLANTILLAS_POR_HORA) {
+    await eliminarMarcador();
+    return resp(429, { error: "Se alcanzó el límite de solicitudes por hora. Intenta más tarde.", code: "template_rate_limited" });
+  }
+
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 20000);
+  let respuestaMeta; let datosMeta = {};
+  try {
+    respuestaMeta = await fetchFn(`https://graph.facebook.com/${graphVersion}/${wa.waba_id}/message_templates`, {
+      method: "POST",
+      headers: { "Authorization": `Bearer ${token}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ name: valor.nombre, category: valor.categoria, language: valor.idioma, components: construirComponentesMeta(valor) }),
+      signal: controller.signal,
+    });
+    datosMeta = await respuestaMeta.json().catch(() => ({}));
+  } catch {
+    // Puede que Meta sí la haya creado: se deja el marcador para que el reintento la adopte o la reintente.
+    return resp(502, { error: "Meta no respondió a tiempo. Intenta de nuevo.", code: "meta_unreachable" });
+  } finally { clearTimeout(timer); }
+
+  if (!respuestaMeta.ok || !(datosMeta && datosMeta.id)) {
+    const mensaje = mensajeErrorMeta(datosMeta) || `HTTP ${respuestaMeta.status}`;
+    const tipo = clasificarErrorMeta(respuestaMeta.status, datosMeta);
+    if (tipo === "conflicto") {
+      // Meta ya la tiene (intento anterior cuya respuesta se perdió): se adopta solo si el texto es idéntico.
+      const enMeta = await consultarPlantillaEnMeta({ fetchFn, graphVersion, token }, String(wa.waba_id), valor.nombre, valor.idioma);
+      const componenteCuerpo = enMeta && Array.isArray(enMeta.components) ? enMeta.components.find((componente) => componente.type === "BODY") : null;
+      if (enMeta && enMeta.id && String((componenteCuerpo && componenteCuerpo.text) || "") === valor.cuerpo) {
+        const estadoMeta = normalizarEstadoPlantilla(enMeta.status);
+        const { data: adoptada } = await sb.from("wa_plantillas").update({
+          meta_template_id: String(enMeta.id), estado: estadoMeta,
+          categoria: normalizarCategoriaPlantilla(enMeta.category, valor.categoria),
+          motivo_rechazo: motivoRechazoVisible(estadoMeta, enMeta.rejected_reason),
+        }).eq("tenant_id", tenantId).eq("nombre", valor.nombre).eq("idioma", valor.idioma).select(PLANTILLA_SELECT).maybeSingle();
+        if (adoptada) return resp(200, { ok: true, existing: true, template: plantillaWhatsappDto(adoptada) });
+      }
+      await eliminarMarcador();
+      return resp(409, { error: "Meta ya tiene una plantilla con ese nombre e idioma.", code: "template_name_taken" });
+    }
+    await eliminarMarcador();
+    if (tipo === "no_disponible") {
+      log("crearPlantillaWhatsappInbox meta no disponible:", respuestaMeta.status, datosMeta && datosMeta.error && datosMeta.error.code);
+      return resp(503, { error: "LANA no pudo contactar a Meta en este momento. Intenta más tarde.", code: "meta_unavailable" });
+    }
+    return resp(422, { error: "Meta rechazó la plantilla: " + mensaje, code: "meta_rejected" });
+  }
+
+  const { data: fila, error: errorActualizar } = await sb.from("wa_plantillas").update({
+    meta_template_id: String(datosMeta.id), estado: normalizarEstadoPlantilla(datosMeta.status),
+    categoria: normalizarCategoriaPlantilla(datosMeta.category, valor.categoria),
+  }).eq("tenant_id", tenantId).eq("nombre", valor.nombre).eq("idioma", valor.idioma).select(PLANTILLA_SELECT).maybeSingle();
+  if (errorActualizar || !fila) {
+    // La plantilla ya está en Meta; el marcador sin id la deja recuperable en el siguiente reintento.
+    log("crearPlantillaWhatsappInbox registro:", errorActualizar && errorActualizar.code);
+    return resp(500, { error: "La plantilla se envió a Meta, pero no se pudo registrar en LANA. Vuelve a intentar para completarla.", code: "template_not_recorded" });
+  }
+  return resp(201, { ok: true, existing: false, template: plantillaWhatsappDto(fila) });
+}
diff --git a/tests/camila-api-plantillas-smyl.test.mjs b/tests/camila-api-plantillas-smyl.test.mjs
